# Delta Exchange India credentials — copy to .env and fill in your own values.
# Never commit the real .env file.
DELTA_API_KEY=YOUR_API_KEY
DELTA_API_SECRET=YOUR_API_SECRET
DELTA_EMAIL=you@example.com
DELTA_PASSWORD=YOUR_PASSWORD
DELTA_TOTP_SECRET=YOUR_TOTP_SECRET
DELTA_BASE_URL=https://api.india.delta.exchange
